# Havyn local bootstrap
# 1) npx vercel link --yes
# 2) npx vercel env pull .env.local --environment=development --yes
#
# Most secrets/connection values are provisioned by Vercel Marketplace integrations
# (Supabase, Upstash, etc.) and should come from `vercel env pull`.

# Public app URL used in links/callbacks for local dev.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Non-secret feature flags / local-only knobs.
ENABLE_AI_SUGGESTIONS="false"
OPENAI_COPILOT_MODEL=""
DEV_ORGANIZATION_ID=""
DEV_USER_ID=""
