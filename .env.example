# Havyn local bootstrap
# 1) npx vercel link --yes
# 2) npx vercel env pull .env.local --environment=development --yes
#
# Most secrets/connection values are provisioned by Vercel Marketplace integrations
# (Supabase, Upstash, etc.) and should come from `vercel env pull`.

# Public app URL used in links/callbacks for local dev.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Non-secret feature flags / local-only knobs.
ENABLE_AI_SUGGESTIONS="false"
OPENAI_COPILOT_MODEL=""
DEV_ORGANIZATION_ID=""
DEV_USER_ID=""

# QA only: allow the same phone to create a new Lead per ingest (skips email + phone / SMS-identity dedupe).
# Creates extra leads — clean up test data periodically.
# Defaults for this repo: vercel.json (Vercel) and .env.development (local `npm run dev`). If you use .env.local from
# `vercel env pull`, add these lines there too (pull does not always include them).
# Comma-separated; each entry is normalized (US 10-digit or +E.164), e.g. +16506952683,6506952683
APPLICATION_PHONE_DEDUPE_BYPASS_E164=""
# When unset or any value other than "false", bypass only runs on Vercel preview or local development.
APPLICATION_PHONE_DEDUPE_BYPASS_REQUIRE_PREVIEW="true"
# Optional: comma-separated Organization ids — if set, bypass applies only to these orgs.
APPLICATION_PHONE_DEDUPE_BYPASS_ORG_IDS=""
